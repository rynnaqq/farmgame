# Local single-player (PRD default, no backend required)
VITE_GAME_MODE=local

# Only required for Project Verdant MMO overlay (VITE_GAME_MODE=verdant).
# Never commit real values. Never use a service_role key in VITE_* vars.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
